{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "verdict": {
      "type": "string",
      "enum": ["pass", "fail"]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "file": {
            "type": "string"
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "ac_id": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": ["blocking", "minor"]
          },
          "problem": {
            "type": "string"
          }
        },
        "required": [
          "file",
          "line",
          "ac_id",
          "severity",
          "problem"
        ]
      }
    }
  },
  "required": ["verdict", "findings"]
}
