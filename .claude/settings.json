{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "dontAsk",
    "disableBypassPermissionsMode": "disable",
    "disableAutoMode": "disable",
    "blockReadsOutsideWorkingDirectories": true,
    "blockWritesOutsideWorkingDirectories": true,
    "allow": [
      "Edit(./agent-patches/**)",
      "Bash(python -m pytest)",
      "Bash(python -m pytest --cov=app --cov-branch --cov-report=term-missing --cov-fail-under=80)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(rm -r *)",
      "Bash(rm -R *)",
      "Edit(./tests/acceptance/**)",
      "Edit(./tests/conftest.py)",
      "Edit(./tests/__init__.py)",
      "Edit(./conftest.py)",
      "Edit(./pytest.ini)",
      "NotebookEdit",
      "Edit(./tests/helpers.py)"
    ]
  }
}
